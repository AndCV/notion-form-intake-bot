# Notion
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Id del data source (no del database) de la base "Solicitudes ACV" -- se
# obtiene consultando la API (ver README, seccion "Encontrar el data source id").
NOTION_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000

# Gmail (envio de correo via SMTP + App Password, sin dominio propio)
# La cuenta necesita verificacion en 2 pasos activada para poder generar una
# App Password (ver README, seccion "Gmail (envio de correo)").
GMAIL_ADDRESS=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Calendar (service account)
# Pegar el JSON completo del service account en una sola linea, o su
# version en base64 (ver README para el paso a paso).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CALENDAR_ID=tu_correo@gmail.com

# Comportamiento
TIMEZONE=America/Costa_Rica
# Duracion por defecto de una clase (el form solo manda la hora de inicio).
CLASS_DURATION_MINUTES=60
# Si se crea un evento de todo el dia para la rama "Asesoria" en su fecha limite.
ASESORIA_CREATE_CALENDAR_EVENT=true
