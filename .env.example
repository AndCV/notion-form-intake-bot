# Notion
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Data source id (not the database id) of your target Notion database -- get
# it by querying the API (see README, "Finding the Notion data source id").
NOTION_DATA_SOURCE_ID=00000000-0000-0000-0000-000000000000

# Zoho Mail (sends email via SMTP over SSL + App Password, no custom domain
# required). Generate the App Password in your Zoho account's security
# settings (see README, "Zoho Mail (sending email)").
ZOHO_ADDRESS=you@zohomail.com
ZOHO_APP_PASSWORD=xxxxxxxxxxxx

# Postgres (Neon) -- the services ledger. Copy the connection string from the
# Neon console; schema in db/schema.sql, applied by scripts/migrate.py.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Web app login (app/main.py). Put APP_PASSWORD=<at least 10 chars> here and
# run `python scripts/hash_password.py`: it swaps it for APP_PASSWORD_HASH and
# adds a random SESSION_SECRET. Never keep the plain password.
APP_PASSWORD_HASH=
SESSION_SECRET=
# Only for local http://localhost runs; leave unset (true) in production.
# COOKIE_SECURE=false

# Google Calendar (service account)
# Paste the full service account JSON on a single line, or its base64
# version (see README for the full walkthrough).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CALENDAR_ID=you@gmail.com

# Behavior
# Display name used in the confirmation email copy.
BUSINESS_NAME=Your Business
TIMEZONE=America/Costa_Rica
# Default class duration (the form only sends the start time).
CLASS_DURATION_MINUTES=60
# Whether an all-day event is created for the "Advisory" branch on its deadline.
ADVISORY_CREATE_CALENDAR_EVENT=true

# Invoicing (see templates/invoice.html and lib/invoicing.py)
# A row only gets invoiced once it has a price set in Notion -- these are
# just the invoice's letterhead/contact details.
INVOICE_ISSUER_NAME=Your Name
INVOICE_TAGLINE=
INVOICE_PHONE=
INVOICE_EMAIL=you@zohomail.com
INVOICE_ADDRESS=
INVOICE_WEBSITE=
INVOICE_PAYMENT_METHOD=Bank transfer
INVOICE_CURRENCY_SYMBOL=$
